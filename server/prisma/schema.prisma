generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  RESIDENT
  ADMIN
}

enum AssetStatus {
  ACTIVE
  INACTIVE
}

enum ComplaintSource {
  MANUAL
  QR
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Category {
  PLUMBING
  ELECTRICAL
  CLEANING
  SECURITY
  LIFT
  PARKING
  OTHER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  societyId Int @default(1)
  society Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(RESIDENT)
  enrollmentPending Boolean @default(false)
  disabled   Boolean @default(false)
  tower      String?
  bills      Bill[]
  paymentsVerified Payment[]
  messages CommunityMessage[]
  reports MessageReport[]
  flatNumber String
  phone      String?
  avatarUrl  String?
  avatarPublicId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  complaints    Complaint[]        @relation("ResidentComplaints")
  statusChanges ComplaintHistory[]
  events        Event[]
  notices       Notice[]

  @@map("users")
}

model Complaint {
  societyId   Int @default(1)
  society     Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  source      ComplaintSource @default(MANUAL)
  id          String   @id @default(cuid())
  title       String
  description String
  category    Category
  priority    Priority
  status      Status   @default(OPEN)
  photoUrl    String?
  photoPublicId String?
  residentId  String?
  assetId     String?
  archivedAt DateTime?
  archivedById String?
  archiveReason String?
  deletedAt DateTime?
  deletedById String?
  isOverdue   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resident User?              @relation("ResidentComplaints", fields: [residentId], references: [id], onDelete: SetNull)
  history  ComplaintHistory[]
  asset    Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([societyId, createdAt])
  @@index([societyId, assetId])
  @@index([residentId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([isOverdue])
  @@index([createdAt])
  @@map("complaints")
}

model Asset {
  societyId   Int @default(1)
  society     Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  id          String @id @default(cuid())
  name        String
  assetCode   String @unique
  description String @default("")
  location    String
  category    String
  qrToken     String @unique
  status      AssetStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  complaints  Complaint[]

  @@index([createdAt, id])
  @@index([societyId, status])
  @@map("assets")
}

/// Append-only audit log. Every status transition creates one record.
/// Records are never updated or deleted.
model ComplaintHistory {
  id          String   @id @default(cuid())
  complaintId String
  changedById String?
  fromStatus  Status
  toStatus    Status
  remark      String?
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([changedById])
  @@index([createdAt])
  @@map("complaint_history")
}

model Notice {
  category String @default("General")
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([isPinned])
  @@index([createdAt])
  @@map("notices")
}

model Society {
  complaints Complaint[]
  residents User[]
  assets Asset[]
  id Int @id @default(1)
  name String
  address String
  description String
  totalFlats Int?
  upcomingMaintenance String?
  maintenanceDate DateTime? @db.Date
}

model Bill {
  id String @id @default(cuid())
  residentId String?
  resident User? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  tower String
  flatNumber String
  month String
  amount Decimal @db.Decimal(12, 2)
  dueDate DateTime @db.Date
  createdAt DateTime @default(now())
  payment Payment?
  @@unique([tower, flatNumber, month])
  @@index([residentId, month])
}

model Payment {
  id String @id @default(cuid())
  billId String @unique
  bill Bill @relation(fields: [billId], references: [id])
  reference String @unique
  verifiedById String?
  verifiedBy User? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  paidAt DateTime @default(now())
}

model CommunityMessage {
  imageUrl String?
  imagePublicId String?
  replyToId String?
  replyTo CommunityMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies CommunityMessage[] @relation("MessageReplies")
  @@index([replyToId])
  id String @id @default(cuid())
  senderId String?
  sender User? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  body String
  createdAt DateTime @default(now())
  removedAt DateTime?
  removedById String?
  reports MessageReport[]
  @@index([createdAt, id])
}

model MessageReport {
  id String @id @default(cuid())
  messageId String
  message CommunityMessage @relation(fields: [messageId], references: [id])
  reporterId String?
  reporter User? @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reason String
  createdAt DateTime @default(now())
  @@unique([messageId, reporterId])
}


model Event {
 id String @id @default(cuid())
 title String
 description String
 startsAt DateTime
 location String
 imageUrl String?
  imagePublicId String?
 creatorId String?
 creator User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 removedAt DateTime?
 @@index([startsAt, id])
}
