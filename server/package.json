{
  "name": "societycare-server",
  "version": "1.0.0",
  "description": "SocietyCare — Express REST API",
  "private": true,
  "main": "server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --test tests/**/*.test.js",
    "test:database": "node tests/database/workspace-check.js",
    "test:coverage": "node --experimental-test-coverage --test tests/**/*.test.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "node-cron": "^4.6.0",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "6.19.3",
    "supertest": "^7.2.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
