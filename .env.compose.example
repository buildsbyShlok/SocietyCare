# Copy to .env.compose; use: docker compose --env-file .env.compose up --build -d
POSTGRES_USER=society_user
POSTGRES_PASSWORD=
POSTGRES_DB=society_maintenance
# Match PostgreSQL credentials above, URL-encoding special characters.
COMPOSE_DATABASE_URL=postgresql://society_user:REPLACE_PASSWORD@postgres:5432/society_maintenance
JWT_SECRET=
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=

# Public HTTPS frontend origin for production QR labels (client build setting).
# VITE_PUBLIC_FRONTEND_URL=
