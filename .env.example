# Copy to server/.env only if absent. Never commit credentials.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/society_maintenance
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CRON_OVERDUE_INTERVAL=*/30 * * * *

# Optional integrations: leave empty unless configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=

# Put this separately in client/.env:
# VITE_API_URL=http://localhost:5000/api

# Public HTTPS frontend origin for production QR labels (client build setting).
# VITE_PUBLIC_FRONTEND_URL=
